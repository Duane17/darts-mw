# Copy to .env.local for local dev. NEXT_PUBLIC_* values are baked in at BUILD time,
# so set them when running `next build` (rebuild after changing them).

# REQUIRED in production. Base URL of darts-api, no trailing slash. Default: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional server-side override for the API URL (e.g. an internal address). Falls back to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=
# Season shown by default on standings/fixtures. Default: 2025
NEXT_PUBLIC_SEASON=2025
